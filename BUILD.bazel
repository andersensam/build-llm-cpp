load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Logging library present across nearly all of the individual libraries packages
cc_library(
    name = "llmlog",
    srcs = glob(
        [
            "src/Log.cpp"
        ]
    ),
    hdrs = glob(
        [
            "src/include/Log.hpp"
        ]
    ),
    strip_include_prefix = "src",
    includes = [],
)

# Numeric definitions for use by Tensor and TensorSlice, defining
# which types can be used and their associated double-width types
cc_library(
    name = "numerics",
    hdrs = glob(
        [
            "src/include/Numerics.hpp"
        ]
    ),
    strip_include_prefix = "src",
    includes = [],
    deps = []
)

# Math operations executed by Tensors and TensorSlices, checking for
# overflow and underflow, ensuring the right casting is used, etc.
cc_library(
    name = "tensormath",
    hdrs = glob(
        [
            "src/include/TensorMath.hpp"
        ]
    ),
    strip_include_prefix = "src",
    includes = [],
    deps = [
        ":numerics",
    ]
)

# Tensor template library
cc_library(
    name = "tensor",
    hdrs = glob(
        [
            "src/include/Tensor.hpp"
        ]
    ),
    strip_include_prefix = "src",
    includes = [],
    deps = [
        ":llmlog",
        ":numerics",
        ":tensormath",
    ]
)

# TensorSlice template library
cc_library(
    name = "tensorslice",
    srcs = glob(
        [
            "src/TensorSlice.cpp"
        ]
    ),
    hdrs = glob(
